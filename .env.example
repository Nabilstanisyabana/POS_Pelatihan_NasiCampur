# ==============================================================================
# NusaPOS - Konfigurasi Environment & MiomiPay Gateway
# ==============================================================================

# Kredensial MiomiPay (Dapatkan dari Dashboard MiomiDev > Integrasi API)
# Gunakan prefix MP-SB- untuk Sandbox Simulator, MP-LIVE- untuk Produksi
MIOMIPAY_BASE_URL=https://pg.miomidev.com/api/v1
MIOMIPAY_API_KEY=MP-SB-YOUR_API_KEY_HERE
MIOMIPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# URL Callback & Redirect
MIOMIPAY_SUCCESS_URL=https://pg.miomidev.com/pay/success

# Port Server Backend POS (Opsional)
PORT=3000
